# === Data (144 GB) ===
# All large binary formats — regenerated by get_data.py + convert_to_pert_delta.py
data/**/*.h5
data/**/*.h5ad
data/**/*.npz

# Raw downloads (replogle20 GEO files)
data/**/*.mtx
data/**/*.mtx.gz
data/**/*.tsv
data/**/*.tsv.gz
data/**/*.csv.gz
data/**/*.csv
# But keep the reference gene-symbol CSV
!data/ref/gene_info_scgpt.csv

# Temporary / intermediate files
data/**/*.tmp*

# === Models ===
# DL model weights, configs, caches, predictions (regenerable from training)
models/atheus_csb/**/
# But keep documentation + manifest at the atheus_csb level
!models/atheus_csb/README.md
!models/atheus_csb/MANIFEST.json

# Empty staging dir
models/atheus_csb_staging/

# Per-(dataset, predictor, scenario, fold) run artifacts — predictions.npz,
# weights.npz, checkpoint/, metrics json/csv/ckpt. Large & regenerable via
# run_pipeline. Ignored at the RUN-DIR level: git does not descend into an
# ignored directory, so any !negation must sit ABOVE this subtree.
models/*/*/*/*/
# Legacy gene-panel tree (pre single-panel rebuild)
models/*/_panel_*/

# Stray backups under models/ (e.g. MANIFEST.json.bak, .bak2, .bak3)
models/**/*.bak*

# === Generated output ===
results/
figures/
logs/
# Figure-generation scripts are local/scratch tooling (not version-controlled)
plotting/
# SLURM job scripts — local operational tooling, not version-controlled
slurm/

# === Python ===
__pycache__/
*.pyc
*.pyo
*.egg-info/

# === System / editor / local config ===
.DS_Store
*.swp
*~

# === Local W&B run data ===
# Written by training runs; the real record lives on the W&B server.
wandb/

# === Container images ===
*.sif

# === Rendered figures / documents ===
*.pdf

# === Notes / planning docs ===
# Design notes and plans stay local — the repo carries code, not notes.
*.md
# ...but everything under docker/ is interface, not planning notes, and a fresh
# clone needs all of it: the host<->container contract every wrapper is written
# against, the image build definitions, the per-model design notes, the
# training-validation cards that are our evidence a container trains its model
# correctly, and — for PRESAGE, which is Genentech Non-Commercial — the
# MODIFICATIONS.md its NOTICE requires to travel with the code. A clone carrying
# the licence but not the disclosure is a licensing problem, not a docs gap.
!docker/**/*.md
!README.md

# === Synthetic dataset + depth-hypothesis work (excluded for now) ===
data/ecoli_synthetic/
models/ecoli_synthetic/
benchmark/scripts/ecoli_metric_grid.py
