# === Data (144 GB) ===
# All large binary formats — regenerated by get_data.py + convert_to_pert_delta.py
data/**/*.h5
data/**/*.h5ad
data/**/*.npz

# Raw downloads (replogle20 GEO files)
data/**/*.mtx
data/**/*.mtx.gz
data/**/*.tsv
data/**/*.tsv.gz
data/**/*.csv.gz
data/**/*.csv
# But keep the reference gene-symbol CSV
!data/ref/gene_info_scgpt.csv

# Split JSONs & masks (generated by get_data.py)
data/*/splits/

# Temporary / intermediate files
data/**/*.tmp*

# === Models (39 GB) ===
# Baselines (regenerable: ~1 hr via run_baselines.py)
models/baselines_*/

# DL model weights, configs, caches, predictions (regenerable from training)
models/atheus_csb/**/
# But keep documentation + manifest at the atheus_csb level
!models/atheus_csb/README.md
!models/atheus_csb/MANIFEST.json

# PRESAGE standalone training output (weights, caches, predictions)
models/presage_standalone/**/
# But keep manifest if it exists
!models/presage_standalone/MANIFEST.json

# Empty staging dir
models/atheus_csb_staging/

# Per-dataset prediction/weight artifacts (predictions.npz + weights.npz under
# models/{dataset}/_panel_{union,miller_align}/...) — large & regenerable via
# run_pipeline; keep only source/docs (README.md, MANIFEST.json) under models/
models/*/_panel_*/

# Stray backups under models/ (e.g. MANIFEST.json.bak, .bak2, .bak3)
models/**/*.bak*

# === Synthetic data (56 GB) ===
synthetic_datasets/*.h5

# === Generated output ===
results/
figures/
logs/
# Figure-generation scripts are local/scratch tooling (not version-controlled)
plotting/
slurm/figure_*

# === Python ===
__pycache__/
*.pyc
*.pyo
*.egg-info/

# === System / editor / local config ===
.DS_Store
*.swp
*~

# === Container images ===
*.sif
